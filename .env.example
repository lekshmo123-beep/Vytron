# GEMINI_API_KEY: Required for server-side Gemini evidence explanation calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted application URL injected by runtime.
APP_URL="MY_APP_URL"

# VYTRON_SESSION_SECRET: 64-char hex HMAC secret for session token signing (auto-derived in dev if unset).
VYTRON_SESSION_SECRET=""

# NVD_API_KEY: Optional NIST NVD API v2.0 key for higher CVSS enrichment rate limits.
NVD_API_KEY=""
